MONGO_URI=mongodb://127.0.0.1:27017/earnhub
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
CORS_ORIGIN=http://localhost:5173

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=replace-with-your-smtp-password
EMAIL_FROM="EarnHub <your-email@example.com>"
EMAIL_REPLY_TO=support@example.com
EMAIL_TEST_TO=test-recipient@example.com

OTP_EXPIRY_MINUTES=5
PENDING_REGISTRATION_TTL_MINUTES=30
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_VERIFICATION_LOCK_SECONDS=60
